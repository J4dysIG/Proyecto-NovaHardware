<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="InicioDeSesion" content="width=device-width, initial-scale=1.0">
    <title>NovaHardware</title>
    <link rel="stylesheet" href="/views/login.css">
</head>
<body>
    <div class="contenedor-principal">
        <div class="panel-izquierdo"></div>
        <div class="panel-derecho"></div>
        <div class="tarjeta-login">
            <div class="encabezado-azul">
                <h2>NovaHardware</h2>
            </div>
            <form class="cuerpo-formulario" id="loginForm"> 
                <div class="campo-entrada">
                    <i class="fa-solid fa-user"></i>
                    <input type="text" placeholder="Correo" id="input-correo"> 
                </div>
                <div class="campo-entrada">
                    <i class="fa-solid fa-shield-halved"></i>
                    <input type="password" placeholder="Contraseña" id="input-password"> 
                </div>
                <button type="submit" class="boton-iniciar">Iniciar Sesion</button>
                <a href="/users/registro" class="boton-crear" type="button" id="boton-crear">Registrar</a>
            </form>
        </div>
    </div>
</body>
<script src="script.js" alt="anonymous"></script>
</html>