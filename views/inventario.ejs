<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventario - NovaHardware</title>
   <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/modulo.css">
    <link rel="stylesheet" href="/css/components.css">
    <script src="javascript.js" defer></script>
</head>

<body>
    <div class="app-layout">
        
        <aside class="sidebar" role="navigation" aria-label="Menú principal">
            <div class="sidebar-brand">
                <div class="brand-logo">💎</div>
                <span class="brand-name">Nova<span>HW</span></span>
            </div>
            <p class="nav-section-label">Navegación</p>
             <nav class="sidebar-nav">
                <a href="/users/inventario" class="nav-item"> <span class="nav-icon">📦</span>Inventario</a>
                <a href="/users/pedidos" class="nav-item active"> <span class="nav-icon">🛒</span>Pedidos</a>
                <a href="/users/ventas" class="nav-item"><span class="nav-icon">🛒</span>Ventas</a>

                <div class="nav-divider"></div>
                <p class="nav-section-label">Análisis</p>
                <a href="/users/usuarios" class="nav-item"><span class="nav-icon">👥</span>Usuarios</a>
                <a href="/users/reportes" class="nav-item"><span class="nav-icon">📊</span>Reportes</a>
                <a href="/users/configuracion" class="nav-item"><span class="nav-icon">⚙️</span>Configuración</a>
            </nav>
            <div class="sidebar-footer">
                <button id="btn-logout" class="btn-logout"  onclick="window.location.href='/users/logout'">
                    <span class="nav-icon">🚪</span>Cerrar Sesión
                </button>
            </div>
        </aside>

        <main class="dashboard-content">
            
            <header class="main-header">
                <div class="header-left">
                    <h2>Inventario</h2>
                    <p class="breadcrumb">Inventario / Panel de mercancía</p>
                </div>
                <div class="header-right">
                    <div class="header-search">
                        <span class="search-icon">🔍</span>
                        <input type="search" placeholder="Buscar en el sistema…" aria-label="Buscar" />
                    </div>
                    <button class="btn-icon" aria-label="Notificaciones">🔔<span class="notif-dot"></span></button>
                    <button class="btn-icon" aria-label="Tema">🌙</button>
                    <div class="user-avatar">AD</div>
                </div>
            </header>

            <div class="inventory-toolbar">
                <div class="action-buttons">
                    <button class="btn btn-primary" id="btn-new">
                        <span class="btn-icon">+</span> Nuevo Producto
                    </button>
                    <button class="btn btn-edit" id="btn-edit">✏️ Editar</button>
                    <button class="btn btn-delete" id="btn-delete">🗑️ Eliminar</button>
                    <button class="btn btn-stock" id="btn-update">📦 Actualizar Stock</button>
                </div>
                
                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input type="text" id="search-inventory" placeholder="Buscar por ID, nombre o categoría...">
                </div>
            </div>

            <div class="inventory-card">
                <div class="card-header">
                    <h3>Listado de Existencias</h3>
                </div>
                
                <div class="table-responsive">
                    <table class="inventory-table" id="inventory-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Stock</th>
                                <th>Precio</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody id="inventory-body">
                            <tr>
                                <td><span class="badge-code">#NH-1024</span></td>
                                <td><strong>Procesador AMD Ryzen 5 5600X</strong></td>
                                <td>Componentes</td>
                                <td>AMD</td>
                                <td>Zen 3</td>
                                <td><span class="stock-badge stock-in">24 unidades</span></td>
                                <td>$189.00</td>
                                <td><span class="status-badge status-active">Disponible</span></td>
                            </tr>
                            <tr>
                                <td><span class="badge-code">#NH-2048</span></td>
                                <td><strong>Memoria RAM Corsair Vengeance 16GB</strong></td>
                                <td>Memorias</td>
                                <td>Corsair</td>
                                <td>LPX DDR4</td>
                                <td><span class="stock-badge stock-low">3 unidades</span></td>
                                <td>$75.00</td>
                                <td><span class="status-badge status-low">Stock Bajo</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>

    </div>
</body>
</html>