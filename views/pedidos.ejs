<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedidos a Proveedores - NovaHardware</title>
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/modulo.css">
    <link rel="stylesheet" href="/css/components.css">
    <script src="javascript.js" defer></script>
</head>

<body>
    <div class="app-layout">

        <aside class="sidebar" role="navigation" aria-label="Menú principal">
            <div class="sidebar-brand">
                <div class="brand-logo">💎</div>
                <span class="brand-name">Nova<span>HW</span></span>
            </div>
            <p class="nav-section-label">Navegación</p>
             <nav class="sidebar-nav">
                <a href="/users/inventario" class="nav-item"> <span class="nav-icon">📦</span>Inventario</a>
                <a href="/users/pedidos" class="nav-item active"> <span class="nav-icon">🛒</span>Pedidos</a>
                <a href="/users/ventas" class="nav-item"><span class="nav-icon">🛒</span>Ventas</a>

                <div class="nav-divider"></div>
                <p class="nav-section-label">Análisis</p>
                <a href="/users/usuarios" class="nav-item"><span class="nav-icon">👥</span>Usuarios</a>
                <a href="/users/reportes" class="nav-item"><span class="nav-icon">📊</span>Reportes</a>
                <a href="/users/configuracion" class="nav-item"><span class="nav-icon">⚙️</span>Configuración</a>
            </nav>
            <div class="sidebar-footer">
                <button id="btn-logout" class="btn-logout"  onclick="window.location.href='/users/logout'">
                    <span class="nav-icon">🚪</span>Cerrar Sesión
                </button>
            </div>
        </aside>

        <main class="dashboard-content">

            <header class="main-header">
                <div class="header-left">
                    <h2>Pedidos a Proveedores</h2>
                    <p class="breadcrumb">Pedidos / Registro de suministros</p>
                </div>
<div class="header-right">
                        <div class="header-search">
                            <span class="search-icon">🔍</span>
                            <input type="search" placeholder="Buscar en el sistema…" aria-label="Buscar" />
                        </div>
                        <button class="btn-icon" aria-label="Notificaciones">🔔<span class="notif-dot"></span></button>
                        <button class="btn-icon" aria-label="Tema">🌙</button>
                        <div class="user-avatar">AD</div>
                </div>
            </header>

            <div class="inventory-toolbar"
                style="background: white; padding: 20px; border-radius: 14px; border: 1px solid #e2e8f0; margin-bottom: 20px;">
                <div style="display: flex; gap: 15px; flex-wrap: wrap; width: 100%; align-items: flex-end;">

                    <div style="flex: 2; min-width: 200px;">
                        <label
                            style="display:block; font-size:12px; font-weight:600; margin-bottom:5px; color:#64748b;">Proveedor</label>
                        <select id="select-proveedor"
                            style="width:100%; padding:11px; border-radius:10px; border:1px solid #e2e8f0; font-family:inherit;">
                            <option value="">-- Selecciona un proveedor --</option>
                            <option value="AMD Oficial">AMD Oficial</option>
                            <option value="Intel Latam">Intel Latam</option>
                            <option value="Corsair Wholesale">Corsair Wholesale</option>
                            <option value="ASUS Tech">ASUS Tech</option>
                        </select>
                    </div>

                    <div style="flex: 1; min-width: 150px;">
                        <label
                            style="display:block; font-size:12px; font-weight:600; margin-bottom:5px; color:#64748b;">Fecha
                            Estimada de Entrega</label>
                        <input type="date" id="input-fecha-estimada"
                            style="width:100%; padding:9px; border-radius:10px; border:1px solid #e2e8f0; font-family:inherit;">
                    </div>

                    <button type="button" class="btn btn-primary" id="btn-registrar-pedido" style="height: 44px;">
                        ➕ Registrar Pedido
                    </button>
                </div>
            </div>

            <div class="inventory-card">
                <div class="card-header">
                    <h3>Órdenes de Compra Activas</h3>
                </div>

                <div class="table-responsive">
                    <table class="inventory-table">
                        <thead>
                            <tr>
                                <th>ID Pedido</th>
                                <th>Proveedor</th>
                                <th>Fecha</th>
                                <th>Estimada</th>
                                <th>Estado</th>
                                <th style="text-align: center;">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="proveedores-pedido-body">
                            <tr>
                                <td><span class="badge-code">#P-1001</span></td>
                                <td><strong>ASUS Tech</strong></td>
                                <td>24/05/2026</td>
                                <td>30/05/2026</td>
                                <td><span class="stock-badge stock-in"
                                        style="background-color: #fee2e2; color: #b91c1c;">Pendiente</span></td>
                                <td style="text-align: center;">
                                    <div class="action-buttons" style="justify-content: center;">
                                        <button class="btn-action btn-stock btn-completar"
                                            title="Marcar como Recibido">✅ Recibido</button>
                                        <button class="btn-eliminar-pedido"
                                            style="background:none; border:none; color:#ef4444; cursor:pointer;">🗑️</button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</body>

</html>