<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/registro.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <title>Registro - NovaHardware</title>
</head>
<body>
    <div class="registro-container">
        <div class="panel-izquierdo"></div>

        <div class="tarjeta-login">
            <div class="encabezado-azul">
                <h2>NovaHardware</h2>
                <% if (typeof errors != 'undefined' && errors.length > 0) { %>
                    <ul style="color: #ffcccc; margin-top: 8px; list-style: none; font-size: 13px;">
                        <% errors.forEach(error => { %>
                            <li>⚠ <%= error %></li>
                        <% }) %>
                    </ul>
                <% } %>
            </div>

            <form action="/users/registro" class="cuerpo-formulario" method="POST">
                <div class="campo-entrada">
                    <i class="fa-solid fa-user"></i>
                    <input type="text" name="nombre" placeholder="Nombre Completo" required>
                </div>
                <div class="campo-entrada">
                    <i class="fa-solid fa-envelope"></i>
                    <input type="email" name="correo" placeholder="Correo Electrónico" required>
                </div>
                <div class="campo-entrada">
                    <i class="fa-solid fa-lock"></i>
                    <input type="password" name="contrasena" placeholder="Contraseña" required>
                </div>
                <div class="campo-entrada">
                    <i class="fa-solid fa-lock"></i>
                    <input type="password" name="contrasena2" placeholder="Confirmar Contraseña" required>
                </div>
                <button type="submit" class="boton-registrar">REGISTRAR</button>
            </form>

            <div class="pie-formulario">
                <a href="/users/login" class="boton-volver">¿Ya tienes una cuenta? Inicia Sesión</a>
            </div>
        </div>
    </div>
</body>
</html>