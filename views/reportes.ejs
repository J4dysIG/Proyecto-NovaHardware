<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedidos a Proveedores - NovaHardware</title>
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/modulo.css">
    <link rel="stylesheet" href="/css/components.css">
    <script src="/js/javascript.js" defer></script>
</head>

<body>


    <div class="app-layout">
        <aside class="sidebar" role="navigation" aria-label="Menú principal">
            <div class="sidebar-brand">
                <div class="brand-logo">💎</div>
                <span class="brand-name">Nova<span>HW</span></span>
            </div>
            <p class="nav-section-label">Navegación</p>
             <nav class="sidebar-nav">
                <a href="/users/inventario" class="nav-item"> <span class="nav-icon">📦</span>Inventario</a>
                <a href="/users/pedidos" class="nav-item active"> <span class="nav-icon">🛒</span>Pedidos</a>
                <a href="/users/ventas" class="nav-item"><span class="nav-icon">🛒</span>Ventas</a>

                <div class="nav-divider"></div>
                <p class="nav-section-label">Análisis</p>
                <a href="/users/usuarios" class="nav-item"><span class="nav-icon">👥</span>Usuarios</a>
                <a href="/users/reportes" class="nav-item"><span class="nav-icon">📊</span>Reportes</a>
                <a href="/users/configuracion" class="nav-item"><span class="nav-icon">⚙️</span>Configuración</a>
            </nav>
            <div class="sidebar-footer">
                <button id="btn-logout" class="btn-logout"  onclick="window.location.href='/users/logout'">
                    <span class="nav-icon">🚪</span>Cerrar Sesión
                </button>
            </div>
        </aside>

        <main class="dashboard-content">

            <header class="main-header">
                <div class="header-left">
                    <h2>Reportes y Estadísticas</h2>
                    <p class="breadcrumb">Reportes </p>
                </div>
                <div class="header-right">
                    <div class="header-search">
                        <span class="search-icon">🔍</span>
                        <input type="search" placeholder="Buscar en el sistema…" aria-label="Buscar" />
                    </div>
                    <button class="btn-icon" aria-label="Notificaciones">🔔<span class="notif-dot"></span></button>
                    <button class="btn-icon" aria-label="Tema">🌙</button>
                    <div class="user-avatar">AD</div>
                </div>
            </header>

            <button class="btn btn-primary">⬇ Exportar a PDF</button>

            <div
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 30px;">
                <!-- Tarjeta 1 -->
                <div class="inventory-card" style="padding: 20px; border-left: 5px solid #10b981;">
                    <p style="color: #64748b; font-size: 14px; margin-bottom: 5px;">Ventas del Mes</p>
                    <h3 style="font-size: 24px;">$12,450.00</h3>
                    <small style="color: #10b981;">+12% respecto al mes anterior</small>
                </div>
                <!-- Tarjeta 2 -->
                <div class="inventory-card" style="padding: 20px; border-left: 5px solid #3b82f6;">
                    <p style="color: #64748b; font-size: 14px; margin-bottom: 5px;">Valor de Inventario</p>
                    <h3 style="font-size: 24px;">$45,200.00</h3>
                    <small style="color: #64748b;">542 productos en total</small>
                </div>
                <!-- Tarjeta 3 -->
                <div class="inventory-card" style="padding: 20px; border-left: 5px solid #f59e0b;">
                    <p style="color: #64748b; font-size: 14px; margin-bottom: 5px;">Pedidos Pendientes</p>
                    <h3 style="font-size: 24px;">8</h3>
                    <small style="color: #ef4444;">3 con retraso</small>
                </div>
            </div>

            <div class="inventory-card">
                <div class="card-header">
                    <h3>Productos más vendidos</h3>
                </div>
                <div style="padding: 20px;">
                    <!-- Simulación de barras de reporte -->
                    <div style="margin-bottom: 15px;">
                        <div style="display:flex; justify-content:space-between; margin-bottom:5px;"><span>Ryzen 5
                                5600X</span> <span>85 unidades</span></div>
                        <div style="background:#e2e8f0; height:8px; border-radius:4px;">
                            <div style="background:#4f46e5; width:85%; height:100%; border-radius:4px;"></div>
                        </div>
                    </div>
                    <div>
                        <div style="display:flex; justify-content:space-between; margin-bottom:5px;"><span>RAM Corsair
                                16GB</span> <span>62 unidades</span></div>
                        <div style="background:#e2e8f0; height:8px; border-radius:4px;">
                            <div style="background:#4f46e5; width:62%; height:100%; border-radius:4px;"></div>
                        </div>
                    </div>
                </div>
            </div>



        </main>
    </div>


</body>

</html>