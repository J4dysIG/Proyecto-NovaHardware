<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ventas - NovaHardware</title>
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/modulo.css">
    <link rel="stylesheet" href="/css/components.css">
    <script src="javascript.js" defer></script>
</head>

<body>
    <div class="app-layout">
<aside class="sidebar" role="navigation" aria-label="Menú principal">
            <div class="sidebar-brand">
                <div class="brand-logo">💎</div>
                <span class="brand-name">Nova<span>HW</span></span>
            </div>
            <p class="nav-section-label">Navegación</p>
            <nav class="sidebar-nav">
                <a href="/users/inventario" class="nav-item"> <span class="nav-icon">📦</span>Inventario</a>
                <a href="/users/pedidos" class="nav-item active"> <span class="nav-icon">🛒</span>Pedidos</a>
                <a href="/users/ventas" class="nav-item"><span class="nav-icon">🛒</span>Ventas</a>

                <div class="nav-divider"></div>
                <p class="nav-section-label">Análisis</p>
                <a href="/users/usuarios" class="nav-item"><span class="nav-icon">👥</span>Usuarios</a>
                <a href="/users/reportes" class="nav-item"><span class="nav-icon">📊</span>Reportes</a>
                <a href="/users/configuracion" class="nav-item"><span class="nav-icon">⚙️</span>Configuración</a>
            </nav>
            <div class="sidebar-footer">
                <button id="btn-logout" class="btn-logout"  onclick="window.location.href='/users/logout'">
                    <span class="nav-icon">🚪</span>Cerrar Sesión
                </button>
            </div>
        </aside>

        <main class="dashboard-content">
                <header class="main-header">
                    <div class="header-left">
                        <h2>Ventas</h2>
                        <p class="breadcrumb">Ventas / Nueva Nota de Venta</p>
                    </div>
                    <div class="header-right">
                        <div class="header-search">
                            <span class="search-icon">🔍</span>
                            <input type="search" placeholder="Buscar en el sistema…" aria-label="Buscar" />
                        </div>
                        <button class="btn-icon" aria-label="Notificaciones">🔔<span class="notif-dot"></span></button>
                        <button class="btn-icon" aria-label="Tema">🌙</button>
                        <div class="user-avatar">AD</div>
                    </div>
                </header>

                <div class="sales-container" style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; align-items: start;">
                
                <div class="sales-left-column">
                    
                    <div class="inventory-toolbar" style="background: white; padding: 20px; border-radius: 14px; border: 1px solid #e2e8f0; margin-bottom: 20px;">
                        <div style="display: flex; gap: 15px; width: 100%; align-items: flex-end;">
                            <div style="flex: 3;">
                                <label style="display:block; font-size:12px; font-weight:600; margin-bottom:5px; color:#64748b;">Escanea o Selecciona Producto</label>
                                <select id="sales-select-producto" style="width:100%; padding:11px; border-radius:10px; border:1px solid #e2e8f0; font-family:inherit;">
                                    <option value="" data-precio="0" data-stock="0">-- Buscar artículo --</option>
                                    <option value="Procesador AMD Ryzen 5" data-precio="189.00" data-stock="24">Procesador AMD Ryzen 5 ($189.00 - Stock: 24)</option>
                                    <option value="Memoria RAM Corsair 16GB" data-precio="75.00" data-stock="3">Memoria RAM Corsair 16GB ($75.00 - Stock: 3)</option>
                                    <option value="Tarjeta Gráfica RTX 4060" data-precio="320.00" data-stock="10">Tarjeta Gráfica RTX 4060 ($320.00 - Stock: 10)</option>
                                </select>
                            </div>
                            <div style="flex: 1; max-width: 100px;">
                                <label style="display:block; font-size:12px; font-weight:600; margin-bottom:5px; color:#64748b;">Cant.</label>
                                <input type="number" id="sales-input-cantidad" value="1" min="1" style="width:100%; padding:10px; border-radius:10px; border:1px solid #e2e8f0; text-align:center;">
                            </div>
                            <button class="btn btn-primary" id="btn-sales-add" style="height: 44px;">⚡ Agregar</button>
                        </div>
                    </div>

                    <div class="inventory-card">
                        <div class="card-header">
                            <h3>Artículos en la Nota de Venta</h3>
                        </div>
                        <div class="table-responsive">
                            <table class="inventory-table">
                                <thead>
                                    <tr>
                                        <th>Descripción</th>
                                        <th>Precio Unitario</th>
                                        <th style="text-align: center;">Cantidad</th>
                                        <th>Subtotal</th>
                                        <th style="text-align: center;">Quitar</th>
                                    </tr>
                                </thead>
                                <tbody id="sales-cart-body">
                                    <tr id="sales-empty-row">
                                        <td colspan="5" style="text-align: center; color: #94a3b8; padding: 40px;">
                                            No hay productos cargados en esta venta.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="sales-right-column" style="background: white; padding: 24px; border-radius: 14px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; gap: 20px;">
                    
                    <div>
                        <h3 style="margin: 0 0 15px 0; font-size: 16px; color: #1e293b;">Resumen y Liquidación</h3>
                        
                        <label style="display:block; font-size:12px; font-weight:600; margin-bottom:5px; color:#64748b;">Cliente</label>
                        <input type="text" value="Público General" style="width:100%; padding:10px; border-radius:8px; border:1px solid #e2e8f0; margin-bottom: 15px; font-family:inherit;">

                        <label style="display:block; font-size:12px; font-weight:600; margin-bottom:5px; color:#64748b;">Método de Pago</label>
                        <select id="sales-payment-method" style="width:100%; padding:10px; border-radius:8px; border:1px solid #e2e8f0; margin-bottom: 15px; font-family:inherit;">
                            <option value="efectivo">💵 Efectivo</option>
                            <option value="tarjeta">💳 Tarjeta de Crédito/Débito</option>
                            <option value="transferencia">🏦 Transferencia Bancaria</option>
                        </select>
                    </div>

                    <div style="background: #f8fafc; padding: 15px; border-radius: 10px; display:flex; flex-direction:column; gap:8px;">
                        <div style="display:flex; justify-content:space-between; font-size:13px; color:#64748b;">
                            <span>Subtotal:</span>
                            <span id="sales-subtotal">$0.00</span>
                        </div>
                        <div style="display:flex; justify-content:space-between; font-size:13px; color:#64748b;">
                            <span>IVA (16%):</span>
                            <span id="sales-iva">$0.00</span>
                        </div>
                        <hr style="border:0; border-top:1px solid #e2e8f0; margin:5px 0;">
                        <div style="display:flex; justify-content:space-between; font-size:22px; font-weight:800; color:#1e293b;">
                            <span>TOTAL:</span>
                            <span id="sales-total" style="color: var(--color-primary, #4f46e5);">$0.00</span>
                        </div>
                    </div>

                    <div id="cash-calculator-box">
                        <label style="display:block; font-size:12px; font-weight:600; margin-bottom:5px; color:#64748b;">Efectivo Recibido</label>
                        <input type="number" id="sales-cash-received" placeholder="¿Con cuánto paga?" style="width:100%; padding:12px; border-radius:8px; border:1px solid #e2e8f0; font-size:16px; font-weight:600; margin-bottom: 12px;">
                        
                        <div style="display:flex; justify-content:space-between; font-size:15px; background: #f0fdf4; padding: 12px; border-radius: 8px; color: #166534; font-weight: 700;">
                            <span>Su Cambio:</span>
                            <span id="sales-change">$0.00</span>
                        </div>
                    </div>

                    <button class="btn btn-primary" id="btn-finalize-sale" style="width:100%; padding:15px; justify-content:center; font-size:16px; font-weight:700; margin-top:10px; background-color: #22c55e;">
                        🛒 Finalizar y Cobrar
                    </button>
                </div>

            </div>
        </main>



    </div>

</body>

</html>